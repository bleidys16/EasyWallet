<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_home_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_gray">

    <!-- Floating Main Container Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/container_main_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="@color/petroleum_green"
        app:cardCornerRadius="28dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeWidth="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Top Header Inside Card -->
            <ImageView
                android:id="@+id/iv_menu_decorative"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:src="@drawable/ic_menu"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/white"
                android:contentDescription="@string/menu_description" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_notifications"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/circle_decoration"
                android:backgroundTint="@color/white_alpha_20"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageButton
                    android:id="@+id/btn_notifications"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Notifications"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_notifications"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/tv_notification_badge"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginTop="-6dp"
                    android:layout_marginEnd="-6dp"
                    android:background="@drawable/circle_decoration"
                    android:backgroundTint="@color/lime_green"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="@color/petroleum_green"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_profile"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="12dp"
                android:src="@drawable/ic_profile"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_menu_decorative"
                app:shapeAppearanceOverlay="@style/CircleImage"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tv_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/greeting_user"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@+id/iv_profile"
                app:layout_constraintTop_toTopOf="@+id/iv_profile" />

            <TextView
                android:id="@+id/tv_welcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.7"
                android:text="@string/welcome_back"
                android:textColor="@color/white"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="@+id/tv_greeting"
                app:layout_constraintTop_toBottomOf="@+id/tv_greeting" />

            <!-- Sub-card: Balance (Gradient) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cv_balance"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_balance_gradient"
                android:paddingHorizontal="20dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                app:layout_constraintTop_toBottomOf="@+id/tv_welcome">

                <TextView
                    android:id="@+id/tv_label_balance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.9"
                    android:text="@string/balance_available"
                    android:textColor="@color/petroleum_green"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@+id/tv_balance_value"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed" />

                <TextView
                    android:id="@+id/tv_balance_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.9"
                    android:text="@string/balance_value"
                    android:textColor="@color/petroleum_green"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_label_balance" />

                <ImageButton
                    android:id="@+id/btn_show_balance"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_eye_visible"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginTop="12dp"
                    app:tint="@color/petroleum_green" />

                <ImageView
                    android:layout_width="70dp"
                    android:layout_height="60dp"
                    android:alpha="0.3"
                    android:src="@drawable/ic_logo"
                    android:layout_marginEnd="-10dp"
                    android:layout_marginBottom="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Notification Popup Card (Tooltip to the LEFT of the bell) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_notification_popup"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="12dp"
                app:layout_constraintBottom_toBottomOf="@+id/cl_notifications"
                app:layout_constraintEnd_toStartOf="@+id/cl_notifications"
                app:layout_constraintTop_toTopOf="@+id/cl_notifications"
                app:strokeWidth="0dp">
                <TextView
                    android:id="@+id/tv_notification_msg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp"
                    android:text="¡Has recibido una recarga!"
                    android:textColor="@color/petroleum_green"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Quick Actions Inside Main Card -->
            <LinearLayout
                android:id="@+id/ll_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@+id/cv_balance">

                <!-- Item Transfer -->
                <LinearLayout
                    android:id="@+id/btn_quick_transfer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_squircle"
                        android:backgroundTint="@color/white_alpha_20" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="-32dp"
                        android:src="@drawable/ic_transfer_modern"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/btn_transfer_label"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Item History -->
                <LinearLayout
                    android:id="@+id/btn_quick_history"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_squircle"
                        android:backgroundTint="@color/white_alpha_20" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="-32dp"
                        android:src="@drawable/ic_history_modern"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/btn_history_label"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Item Recharge -->
                <LinearLayout
                    android:id="@+id/btn_quick_recharge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_squircle"
                        android:backgroundTint="@color/white_alpha_20" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginTop="-33dp"
                        android:src="@drawable/ic_wallet"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/btn_recharge_label"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Tab (The Pico) Centered at the bottom of the card -->
    <ImageView
        android:id="@+id/iv_bottom_tab"
        android:layout_width="40dp"
        android:layout_height="24dp"
        android:src="@drawable/bg_balance_decorative"
        android:scaleType="centerInside"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/container_main_card"
        app:layout_constraintTop_toBottomOf="@+id/container_main_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Recent Movements Section (Outside Card, on Light Gray) -->
    <TextView
        android:id="@+id/tv_recent_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:text="@string/recent_movements"
        android:textColor="@color/petroleum_green"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_bottom_tab" />

    <TextView
        android:id="@+id/tv_view_all"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:text="@string/view_all"
        android:textColor="@color/jade_green"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/tv_recent_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_recent_label" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_movements"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_bar_container"
        app:layout_constraintTop_toBottomOf="@+id/tv_recent_label"
        tools:listitem="@layout/item_movement" />

    <LinearLayout
        android:id="@+id/tv_empty_history"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/rv_movements"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/rv_movements">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:alpha="0.2"
            android:src="@drawable/ic_history_modern"
            app:tint="@color/petroleum_green" />

        <TextView
            android:id="@+id/tv_no_movements"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/no_movements"
            android:textColor="@color/gray_text" />
    </LinearLayout>

    <!-- Custom Floating Bottom Bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_bar_container"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/petroleum_green"
        app:cardCornerRadius="28dp"
        app:cardElevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:strokeWidth="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Inicio -->
            <LinearLayout
                android:id="@+id/nav_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintEnd_toStartOf="@+id/btn_central_transfer"
                app:layout_constraintStart_toStartOf="parent">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_home_modern"
                    app:tint="@color/white"
                    android:alpha="0.7" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_home"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:alpha="0.7" />
            </LinearLayout>

            <!-- Botón Transferir -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/btn_central_transfer"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@color/lime_green"
                android:clickable="true"
                android:focusable="true"
                android:padding="16dp"
                android:src="@drawable/ic_transfer_modern"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/CircleImage"
                app:tint="@color/petroleum_green" />

            <!-- Historial -->
            <LinearLayout
                android:id="@+id/nav_history"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/btn_central_transfer">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_history_modern"
                    app:tint="@color/white"
                    android:alpha="0.7" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_history"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:alpha="0.7" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
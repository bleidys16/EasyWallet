<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/light_gray"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <ImageView
            android:id="@+id/iv_movement_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_decoration"
            android:backgroundTint="@color/light_gray"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_send"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/petroleum_green" />

        <TextView
            android:id="@+id/tv_movement_type"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Transferencia enviada"
            android:textColor="@color/petroleum_green"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tv_movement_amount"
            app:layout_constraintStart_toEndOf="@+id/iv_movement_icon"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_movement_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="05 Ago 2026 • 08:30 a. m."
            android:textColor="@color/gray_text"
            android:textSize="10sp"
            app:layout_constraintStart_toStartOf="@+id/tv_movement_type"
            app:layout_constraintTop_toBottomOf="@+id/tv_movement_type" />

        <TextView
            android:id="@+id/tv_movement_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-$ 250.000"
            android:textColor="@android:color/holo_red_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_movement_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/status_background"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="Completado"
            android:textColor="@color/mint_green"
            android:textSize="8sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_movement_amount" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/light_gray"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_movement_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@color/light_gray"
            android:padding="10dp"
            android:src="@drawable/ic_transfer_modern"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/CircleImage"
            app:tint="@color/petroleum_green" />

        <TextView
            android:id="@+id/tv_movement_type"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Nómina"
            android:textColor="@color/petroleum_green"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tv_movement_amount"
            app:layout_constraintStart_toEndOf="@+id/iv_movement_icon"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_movement_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="05 Ago 2026 • 08:30 a. m."
            android:textColor="@color/gray_text"
            android:textSize="11sp"
            app:layout_constraintStart_toStartOf="@+id/tv_movement_type"
            app:layout_constraintTop_toBottomOf="@+id/tv_movement_type" />

        <TextView
            android:id="@+id/tv_movement_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ $ 3.200.000"
            android:textColor="@color/mint_green"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_movement_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/status_background"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Completado"
            android:textColor="@color/jade_green"
            android:textSize="10sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_movement_amount" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>